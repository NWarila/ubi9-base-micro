{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "base-python OCI content identity",
  "description": "Closed OCI Image Specification v1.1.1 profile for one linux platform child, one gzip layer, and imageLayoutVersion 1.0.0.",
  "$comment": "The producer contract uses a per-architecture platform override, type=oci,tar=true,oci-mediatypes=true,compression=gzip,force-compression=true,dest=<per-architecture path>, no target tags, no exporter name, no user annotations, disabled provenance and SBOM attestations, and SOURCE_DATE_EPOCH=1704067200. Engine observations belong in a separate versioned envelope that references and hash-binds this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "platform",
    "index",
    "child",
    "config",
    "layers",
    "annotations",
    "canonical_rootfs_digest",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_version": {
      "type": "string",
      "const": "oci-content-identity/1"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "const": "linux"
        },
        "architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "media_type": {
          "type": "string",
          "const": "application/vnd.oci.image.manifest.v1+json"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "media_type": {
          "type": "string",
          "const": "application/vnd.oci.image.config.v1+json"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "digest",
          "size",
          "media_type",
          "diff_id"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "const": 0
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 402653184
          },
          "media_type": {
            "type": "string",
            "const": "application/vnd.oci.image.layer.v1.tar+gzip"
          },
          "diff_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "key",
          "value"
        ],
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "index",
              "index.manifests[0]",
              "manifest",
              "manifest.config",
              "manifest.layers[0]"
            ]
          },
          "key": {
            "type": "string",
            "maxLength": 256
          },
          "value": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "canonical_rootfs_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 188,
      "maxItems": 188,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
