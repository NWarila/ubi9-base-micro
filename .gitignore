**
# Allow the allowlist itself so tracked scope stays auditable.
!/.gitignore

# Allow git attributes, editor config and markdownlint config so formatting is deterministic.
!/.gitattributes
!/.editorconfig
!/.markdownlint-cli2.jsonc

# Allow the GitHub config root, ownership and dependency-update config.
!/.github/
!/.github/CODEOWNERS
!/.github/renovate.json5

# Allow community health files mirrored from the organization baseline.
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/SUPPORT.md

# Allow the documentation tree and its Diataxis skeleton.
!/docs/
!/docs/tutorials/
!/docs/tutorials/.gitkeep
!/docs/how-to/
!/docs/how-to/.gitkeep
!/docs/reference/
!/docs/reference/.gitkeep
!/docs/reference/alignment-program-lessons.md
!/docs/reference/ci-alignment-design-intent.md
!/docs/reference/ci-validator-invocation.md
!/docs/reference/diagram-conventions.md
!/docs/reference/mirroring.md
!/docs/explanation/
!/docs/explanation/.gitkeep
!/docs/explanation/repo-type-taxonomy-and-ci-focus.md
!/docs/diagrams/
!/docs/diagrams/.gitkeep
!/docs/runbooks/
!/docs/runbooks/.gitkeep

# Allow decision records: organization baseline, template slot, and this repository's own.
!/docs/decision-records/
!/docs/decision-records/org/
!/docs/decision-records/org/.gitkeep
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/org/0005-pin-terraform-and-provider-versions-exactly.md
!/docs/decision-records/org/0006-keep-github-control-planes-namespace-local.md
!/docs/decision-records/org/0007-centralize-universal-ci-reusables-within-each-namespace.md
!/docs/decision-records/org/0008-enforce-repo-hygiene-by-repo-type.md
!/docs/decision-records/org/0009-classify-baseline-manifest-byte-identity.md
!/docs/decision-records/template/
!/docs/decision-records/template/.gitkeep
!/docs/decision-records/repo/
!/docs/decision-records/repo/.gitkeep
!/docs/decision-records/repo/0001-rebuild-the-image-family-from-zero.md

# Allow the shared build inputs: the scripts, the held-RPM lists and the files copied into every image.
!/build/
!/build/STIG.pmod
!/build/build-image.sh
!/build/download-rpms.sh
!/build/generate-lock.sh
!/build/held-rpms.aarch64.txt
!/build/held-rpms.x86_64.txt
!/build/install-tools.txt
!/build/openssl-fips.cnf
!/build/remove-install-only.sh

# Allow the image folders: a Dockerfile, a package list and one generated lock per architecture each.
!/images/
!/images/go-toolset/
!/images/go-toolset/Dockerfile
!/images/go-toolset/packages.lock.aarch64
!/images/go-toolset/packages.lock.x86_64
!/images/go-toolset/packages.txt
!/images/micro/
